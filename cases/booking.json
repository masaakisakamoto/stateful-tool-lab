{
  "metadata": {
    "schema_version": 1,
    "name": "Stateful booking controller fixtures",
    "provenance": "Entirely fictional customers, slots, bookings, instructions and faults. No production data.",
    "independent_scenarios": 12,
    "paired_language_variants": 24,
    "languages": [
      "ja",
      "en"
    ],
    "purpose": "Offline verification of the booking environment, deterministic reference controllers and state grader.",
    "request_semantics": "requests is public structured input for reference controllers, not the grading oracle. The expected field is private to the grader.",
    "limitation": "Controllers consume structured requests rather than interpreting instructions. Language variants therefore do not measure Japanese or English understanding, LLM quality or real-world effectiveness.",
    "oracle_provenance": "Expected outcomes and active-booking multisets were authored independently of the booking environment.",
    "duplicate_semantics": "active_bookings is a multiset encoded as a list; duplicate entries must never be deduplicated by the grader.",
    "identity_semantics": "required_bookings checks preserved identifiers and cancelled rows, so cancel-and-recreate is not equivalent to an atomic move."
  },
